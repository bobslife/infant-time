VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 광고 설정: mock | adsense | admob | sponsor | off
# Use "admob" only after the platform AdMob apps and units exist.
VITE_AD_MODE=off

# Keep this true for local development and internal QA. Set false only for a
# production deployment that has real platform-specific ad unit IDs.
VITE_ADMOB_TESTING=true

# Legacy/shared banner IDs
VITE_ADMOB_BANNER_HOME_BOTTOM=
VITE_ADMOB_BANNER_ACTIVITY_BOTTOM=
VITE_ADMOB_BANNER_ANALYSIS_BOTTOM=
VITE_ADMOB_BANNER_GROWTH_BOTTOM=
VITE_ADMOB_BANNER_PROFILE_BOTTOM=

