<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/infant_time_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_baby_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="앙팡타임"
        android:textColor="#202631"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_empty_copy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="앱을 열어 오늘 기록을 확인해 주세요."
        android:textColor="#687386"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="마지막 수유"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_feed_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#202631"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#4F8CFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#7C5CE0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_diaper_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#687386"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
